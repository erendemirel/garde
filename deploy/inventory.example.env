# garde deployment inventory (example)
#
# Copy to deploy/inventory.env and fill in real values. Never commit inventory.env.
# In CI this whole file is stored as the DEPLOY_INVENTORY secret and written to
# deploy/inventory.env at the start of each run.
#
# Topology: 3 hosts, all three are Vault Raft members.
#   node1  app-primary  (caddy + garde + redis primary + permissions.db writer)
#   node2  app-standby  (caddy warm + garde warm + redis replica + db copy)
#   node3  witness      (vault raft member + prometheus/grafana + backup target)

# ---------------------------------------------------------------------------
# Hosting provider
# ---------------------------------------------------------------------------
# Selects a driver from deploy/scripts/providers/.
# Available: netcup, hetzner, ovh, ionos, scaleway, aws, gcp.
# The driver owns traffic routing and server power, and declares its own
# cooldown and whether hosts must bind the failover address themselves.
PROVIDER=netcup

# Each driver targets one specific product line - the API-driven, fast-switching
# one in each case. The neighbouring products are different APIs entirely:
#   netcup    VPS / root server via the SCP REST API
#   hetzner   Hetzner *Cloud* (dedicated servers use the Robot API: 90-110s)
#   ovh       OVHcloud *VPS*  (dedicated servers and Public Cloud differ)
#   ionos     IONOS *Cloud* v6 (the DCD product, not the shared-hosting range)
#   scaleway  Scaleway *Instances* (Elastic Metal has its own API)
#   aws       EC2 instances + an Elastic IP
#   gcp       Compute Engine instances + a static external IP

# Credentials are passed as environment variables, never stored here:
#   netcup    NETCUP_SCP_REFRESH_TOKEN   (30-day lifetime, re-issue when stale)
#   hetzner   HCLOUD_TOKEN               (project API token, read/write)
#   ovh       OVH_APPLICATION_KEY, OVH_APPLICATION_SECRET, OVH_CONSUMER_KEY
#   ionos     IONOS_TOKEN                (ionosctl token generate)
#   scaleway  SCW_SECRET_KEY             (IAM API key)
#   aws       AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY   (needs the aws CLI)
#   gcp       GOOGLE_APPLICATION_CREDENTIALS, GOOGLE_CLOUD_PROJECT (gcloud CLI)

# OVH only: the API is regional and a key is valid in one region only.
# OVH_ENDPOINT=https://eu.api.ovh.com/1.0

# Scaleway only: all hosts and the flexible IP must share one zone, because an
# IP cannot be attached to an Instance in a different zone.
# SCW_ZONE=fr-par-1

# AWS only: the region holding the instances and the Elastic IP.
# AWS_REGION=eu-central-1

# AWS and GCP only. On both, the hosts carry no public address at all: the
# control plane arrives through the provider's own tunnel and node-to-node
# WireGuard peers over private addresses. That needs three things here -
# NODE*_MESH_ENDPOINT below, a bucket to stage images in, and the range the
# tunnel arrives from, since SSH will not be coming from the mesh subnet.
#
# ADMIN_SSH_SOURCES is required on AWS (your subnet CIDR - the Instance Connect
# Endpoint lives inside your VPC). GCP needs nothing: IAP forwards from a fixed
# published range the driver already declares.
# ADMIN_SSH_SOURCES=10.0.0.0/16
# AWS_IMAGE_BUCKET=garde-images-example
# GCP_IMAGE_BUCKET=garde-images-example

# ---------------------------------------------------------------------------
# SSH
# ---------------------------------------------------------------------------
SSH_USER=deploy
SSH_PORT=22
# SSH goes over the WireGuard mesh; public SSH stays firewalled off.
SSH_OPTS="-o StrictHostKeyChecking=yes -o ConnectTimeout=10"

# Remote install root (owned by SSH_USER)
REMOTE_ROOT=/opt/garde

# ---------------------------------------------------------------------------
# Hosts
# ---------------------------------------------------------------------------
# Logical node list. Order matters for deploys: vault members first, then apps.
NODES="node1 node2 node3"

# WireGuard mesh addresses (private, used for all node-to-node traffic and SSH)
WG_SUBNET=10.10.0.0/24
NODE1_WG_IP=10.10.0.1
NODE2_WG_IP=10.10.0.2
NODE3_WG_IP=10.10.0.3
# The CI runner joins the mesh for the duration of a job.
CI_WG_IP=10.10.0.10
# Your workstation. Required, not optional: once the firewall closes public SSH
# the mesh is the only way in, and the Ansible playbook, the Vault ceremony and
# unseal.sh all run from there.
OPS_WG_IP=10.10.0.11

# Public addresses (WireGuard endpoints; not used for app traffic)
NODE1_PUBLIC_IP=203.0.113.11
NODE2_PUBLIC_IP=203.0.113.12
NODE3_PUBLIC_IP=203.0.113.13
WG_PORT=51820

# Only where the hosts have no public address (AWS, GCP): the address peers dial
# to reach this node's WireGuard listener. Defaults to NODE*_PUBLIC_IP, which is
# what every other provider wants.
# NODE1_MESH_ENDPOINT=10.0.1.11
# NODE2_MESH_ENDPOINT=10.0.2.12
# NODE3_MESH_ENDPOINT=10.0.3.13

# Roles
NODE1_ROLE=app-primary
NODE2_ROLE=app-standby
NODE3_ROLE=witness

# Vault Raft node ids (must be stable and unique)
NODE1_VAULT_ID=vault-1
NODE2_VAULT_ID=vault-2
NODE3_VAULT_ID=vault-3

# The provider's own id for each machine. Only the driver interprets these,
# which is why a provider needing three ids still uses one field.
#   netcup    opaque vXXXXXXXX string   (SCP: GET /servers)
#   hetzner   numeric server id         (hcloud server list)
#   ovh       VPS service name          (vps-a1b2c3d4.vps.ovh.net)
#   ionos     <datacenterId>/<serverId>/<nicId>
#   scaleway  Instance UUID
#   aws       EC2 instance id          (i-0123456789abcdef0)
#   gcp       <zone>/<instance-name>   (europe-west1-b/garde-1)
NODE1_PROVIDER_ID=v12345678
NODE2_PROVIDER_ID=v12345679
NODE3_PROVIDER_ID=v12345680

# ---------------------------------------------------------------------------
# Live role pointers (updated by failover.sh — the only mutable part)
# ---------------------------------------------------------------------------
PRIMARY_NODE=node1
STANDBY_NODE=node2

# ---------------------------------------------------------------------------
# DNS / TLS
# ---------------------------------------------------------------------------
# Both records point at the failover IP, which is routed to PRIMARY_NODE.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
# Registrable domain: garde sets session cookies here so app./api. are same-site.
COOKIE_DOMAIN=example.com
ACME_EMAIL=ops@example.com

# ---------------------------------------------------------------------------
# Public traffic address
# ---------------------------------------------------------------------------
# The address DNS points at. It is routed to whichever host currently serves.
FAILOVER_IP=203.0.113.100

# Optional: the provider's id for that address, if you would rather not have it
# looked up by address on every call. Unused by the ovh and ionos drivers, which
# address it by the IP itself.
#   netcup    GET /users/{userId}/failoverips/v4  (needs "editable": true)
#   hetzner   hcloud floating-ip list
FAILOVER_IP_ID=

# Optional override. Each driver declares the provider's real limit (netcup 301s,
# the others none) and that value is the floor - this can raise it, never lower it.
# FAILOVER_IP_COOLDOWN_SECONDS=301

# ---------------------------------------------------------------------------
# Compose / images
# ---------------------------------------------------------------------------
# Fixed subnet so TRUSTED_PROXIES in Vault can name the Caddy source range.
APP_NET_SUBNET=172.28.0.0/16
GARDE_IMAGE=garde/api
UI_IMAGE=garde/ui
CADDY_IMAGE=garde/caddy
IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Data protection
# ---------------------------------------------------------------------------
# Interval for garde-snapshot.timer on the primary, installed by the Ansible
# snapshot role. This is the recovery point for the permission catalog.
SQLITE_SNAPSHOT_INTERVAL=5min
# Fail backup-verify if the newest snapshot on the standby is older than this.
SQLITE_SNAPSHOT_MAX_AGE_SECONDS=1800
