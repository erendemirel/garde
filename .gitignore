# Compiled binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
garde.exe

# Go specific
go.work
vendor/
# Note: go.sum should be committed

# Build outputs
/bin/
/build/
/web/build/
/web/.svelte-kit/
/.svelte-kit/

# Certificates and keys
/certs/
*.pem
*.key
*.crt
*.csr

# Environment files
.env
.env.local
.env.*.local
.env.production
.env.development
*.secrets
!dev.secrets

# Node.js / Bun
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
bun-debug.log*
# Note: bun.lock and bun.lockb should be committed

