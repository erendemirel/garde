*.swp
*.swo
*.sublime-project
*.sublime-workspace
*.code-workspace

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs
*.log
logs/
dump.rdb

# Secrets directory (except .gitkeep)
secrets/*
!secrets/.gitkeep

# Vault secrets (role-id, secret-id, tokens)
vault/role-id
vault/secret-id
prod.secrets
vault/*.token
vault/dev-token
vault-credentials.json
vault-credentials.json.partial
vault-unseal-keys
vault-unseal-keys.txt

# Deployment: inventory, WireGuard keys/configs, netcup rate-limit state
deploy/inventory.env
deploy/.wg/
deploy/.traffic-last-move
deploy/.ssh-config

# Ansible fact cache and SSH control sockets
ansible/.facts/
ansible/*.retry

# Terraform. Recursive, because terraform/aws/ is a second root module and its
# state holds a generated IAM secret key.
terraform/**/.terraform/
terraform/**/.terraform.lock.hcl
terraform/**/*.tfstate
terraform/**/*.tfstate.*
terraform/**/terraform.tfvars
terraform/**/tfplan
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.*
terraform/terraform.tfvars
terraform/tfplan

# Database files
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite

