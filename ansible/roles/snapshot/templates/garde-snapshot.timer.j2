# MANAGED BY ANSIBLE - roles/snapshot
#
# Enabled on both app nodes. The service exits quickly on the replica because
# SNAPSHOT_REQUIRE_REDIS_MASTER=1 — only the Redis master owns the live catalog.
# Recovery point equals OnUnitActiveSec for changes after the last successful run.
[Unit]
Description=Periodic garde permissions.db snapshot

[Timer]
OnBootSec=5min
OnUnitActiveSec={{ garde_facts.snapshot_interval | default('5min') }}
# Avoid every host firing at the same second.
RandomizedDelaySec=30
Persistent=true

[Install]
WantedBy=timers.target
