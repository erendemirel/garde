# Copy to terraform.tfvars and fill in. That file is gitignored.

region = "eu-central-1"

# Globally unique across all of S3, so put something of your own in it.
image_bucket_name = "garde-images-CHANGEME"

# The key Ansible bootstraps with, not the deploy key CI uses - the playbook
# creates that account itself.
#   ssh-keygen -t ed25519 -f ~/.ssh/garde_bootstrap
ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

# t3.small is the floor for a host running Vault, Redis, the API, the UI and
# Caddy together. Raise it if you plan to leave this running.
# instance_type = "t3.medium"
