# Copy to terraform.tfvars and fill in. That file is gitignored.

region = "eu-central-1"

# Globally unique across all of S3, so put something of your own in it.
image_bucket_name = "garde-images-CHANGEME"

# The key Ansible bootstraps with, not the deploy key CI uses - the playbook
# creates that account itself.
#   ssh-keygen -t ed25519 -f ~/.ssh/garde_bootstrap
# ssh_public_key required only when create_bootstrap_key = true (greenfield).
# create_bootstrap_key = false   # adopt existing ${name}-bootstrap key pair

# When adopting an existing VPC (import), set these to the live CIDRs / IPs.
# Leave unset for a greenfield apply (derives /24s and host .10).
# subnet_cidrs = ["10.0.0.0/20", "10.0.16.0/20", "10.0.32.0/20"]
# node_private_ips = ["10.0.9.185", "10.0.22.97", "10.0.35.224"]

# Route 53: set dns_zone to create a public hosted zone + app/api A records
# pointing at the Elastic IP, and an ACME IAM user for Caddy DNS-01.
# Delegate the registrar to terraform output dns_nameservers.
# Or set dns_zone_id to an existing zone id (Z...) and skip zone creation.
# Leave both empty for a compute-only apply (no public HTTPS until DNS exists).
# dns_zone    = "example.com"
# dns_zone_id = ""
# app_hostname = "app"
# api_hostname = "api"

# t3.small is the floor for a host running Vault, Redis, the API, the UI and
# Caddy together. Raise it if you plan to leave this running.
# instance_type = "t3.medium"

# Bring-up: after editing this file, run from this directory:
#   ./bring-up.sh
# Then track remaining (Ansible / Vault / deploy) with:
#   ../../deploy/scripts/doctor.sh
# Checklist: docs/AWS_BRINGUP.md
