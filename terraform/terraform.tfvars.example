# Copy to terraform.tfvars (gitignored) or pass these as TF_VAR_* environment
# variables from CI.

zone         = "example.com"
app_hostname = "app"
api_hostname = "api"
failover_ip  = "203.0.113.100"
zone_ttl     = 300

# CCP credentials: Customer Control Panel > Master Data > API
netcup_customer_number = "123456"
netcup_api_key         = "..."
netcup_api_password    = "..."

# Only needed if you enable SCP resources
netcup_scp_refresh_token = ""
